AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
PORT=8000

# Local Supermemory (supermemory-server): http://localhost:6767
SUPERMEMORY_BASE_URL=http://localhost:6767
SUPERMEMORY_API_KEY=your_supermemory_api_key

# Public URL used by Agora inline tool calls (tunnel or deployed backend).
PUBLIC_BASE_URL=http://localhost:8000

# Google Calendar MCP (nspady/google-calendar-mcp). Run the MCP server separately
# with HTTP/streamable transport, expose it publicly, then set its /mcp endpoint here.
# Example: https://your-tunnel.example.com/mcp
GOOGLE_CALENDAR_MCP_ENDPOINT=
# Optional auth header value sent to the MCP server, e.g. "Bearer <token>"
GOOGLE_CALENDAR_MCP_AUTH_HEADER=
GOOGLE_CALENDAR_MCP_AUTH_HEADER_NAME=Authorization
# Comma-separated tool allowlist, or * for all.
GOOGLE_CALENDAR_MCP_ALLOWED_TOOLS=*
GOOGLE_CALENDAR_MCP_TIMEOUT_MS=10000

# Optional TTS override. If unset, the agent uses MiniMaxTTS managed by Agora.
MURF_API_KEY=
